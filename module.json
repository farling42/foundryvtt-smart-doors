{
	"id": "smart-doors",
	"title": "Smart Doors",
	"description": "Makes doors smarter. Allows doors to synchronize across multiple scenes and sends chat messages when players try to open locked doors.",
	"version": "#{VERSION}#",
	"compatibility": {
		"minimum": 13,
		"verified": 14
	},
	"authors": [
        {
            "name": "Farling",
            "url": "https://github.com/farling42",
            "email": "foundryvtt@amusingtime.uk",
            "discord": "farling",
            "ko-fi": "farling",
            "patreon": "amusingtime"
        },
        {
			"name": "Manuel Vögele",
			"email": "develop@manuel-voegele.de",
			"discord": "Stäbchenfisch#5107"
		}
	],
	"esmodules": [
		"lib/libwrapper_shim.js",
		"src/main.js"
	],
	"languages": [
		{
			"lang": "de",
			"name": "Deutsch",
			"path": "lang/de.json"
		},
		{
			"lang": "en",
			"name": "English",
			"path": "lang/en.json"
		},
		{
			"lang": "fr",
			"name": "Français",
			"path": "lang/fr.json"
		},
		{
			"lang": "ja",
			"name": "日本語",
			"path": "lang/ja.json"
		},
		{
			"lang": "pt-BR",
			"name": "Português (Brasil)",
			"path": "lang/pt-BR.json"
		}
	],
    "relationships": {
	    "recommends": [
			{
				"id": "lib-wrapper",
				"manifest": "https://github.com/ruipin/fvtt-lib-wrapper/releases/latest/download/module.json"
			}
        ]
    },
	"url": "#{URL}#",
	"manifest": "#{MANIFEST}#",
	"download": "#{DOWNLOAD}#",
	"readme": "https://github.com/farling42/foundryvtt-smart-doors/blob/master/README.md",
	"changelog": "https://github.com/farling42/foundryvtt-smart-doors/blob/master/CHANGELOG.md",
	"bugs": "https://github.com/farling42/foundryvtt-smart-doors/issues"
}
